@using BookStore.Domain.ViewModels.Book
@model ListBookViewModel
@{
    ViewData["Title"] = "لیست کتابها";
}
<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6"><h3 class="mb-0">@ViewData["Title"]</h3></div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item"><a asp-controller="Home" asp-action="AdminPage">خانه</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Category" asp-action="GetAll">لیست دسته بندی</a></li>
                    <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <!--begin::Container-->
    <div class="container-fluid">
        <!--begin::Row-->
        <div class="row">
            <div class="col-12">
                <div class="card mb-4">
                    <div class="card-header">
                        <a asp-action="CreateBookAsync" asp-route-categoryId="@Model.CategoryId" class="btn btn-primary">
                            <i class="fas fa-plus ml-2"></i>افزودن کتاب جدید
                        </a>
                    </div>

                    <!-- /.card-header -->
                    <div class="card-body">
                        <table class="table table-striped table-bordered table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th style="width: 50px">#</th>
                                    <th>تاریخ انتشار</th>
                                    <th>عنوان کتاب</th>
                                    <th>نویسنده</th>
                                    <th>عمانت داده شده؟</th>
                                    <th>حذف شده؟</th>
                                    <th style="width: 200px">عملیات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model != null && Model.Books.Any())
                                {
                                    @foreach (var item in Model.Books)
                                    {
                                        <tr>
                                            <td>@(Model.Books.IndexOf(item) + 1)</td>
                                            <td>@item.PublicationDate</td>
                                            <td>@item.BookTitle</td>
                                            <td>@item.Author</td>
                                            <td><i class="fas @(item.Borrow ? "fa-check text-success" : "fa-times text-danger")"></i></td>
                                            <td><i class="fas @(item.IsDeleted ? "fa-check text-success" : "fa-times text-danger")"></i></td>
                                            <td>
                                                <div class="btn-group btn-group-sm">
                                                    <a asp-action="EditBook" asp-route-bookId="@item.BookId" class="btn btn-warning">
                                                        <i class="fas fa-edit ml-2"></i>ویرایش
                                                    </a>
                                                    <form asp-action="DeleteBook" method="post" asp-route-id="@item.BookId" onsubmit="return confirm('آیا از حذف اطمینان دارید؟')" style="display:inline;">
                                                        <button type="submit" class="btn btn-danger">
                                                            <i class="fas fa-trash ml-2"></i>حذف
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="8" class="text-center">هیچ کاربری یافت نشد</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                    <!-- /.card-body -->
                    <div class="card-footer clearfix">
                        <ul class="pagination pagination-sm m-0 float-end">
                            <li class="page-item"><a class="page-link" href="#">«</a></li>
                            <li class="page-item"><a class="page-link" href="#">1</a></li>
                            <li class="page-item"><a class="page-link" href="#">2</a></li>
                            <li class="page-item"><a class="page-link" href="#">3</a></li>
                            <li class="page-item"><a class="page-link" href="#">»</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <!--end::Row-->
    </div>
    <!--end::Container-->
</div>