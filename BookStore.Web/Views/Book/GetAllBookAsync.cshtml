@using BookStore.Domain.ViewModels.Book
@model ListBookViewModel

 @if(ViewData["Title"].ToString() == "جستجو")
{

<div class="app-content-header">
	<div class="container-fluid">
		<div class="row">
			<div class="col-sm-6"><h3 class="mb-0">@ViewData["Title"]</h3></div>
			<div class="col-sm-6">
				<ol class="breadcrumb float-sm-end">
					<li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">خانه</a></li>
					<li class="breadcrumb-item"><a asp-controller="Book" asp-action="SearchAuthorasync">جستجو</a></li>
					<li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
				</ol>
			</div>
		</div>
	</div>
</div>

}
else
{
{
	ViewData["Title"] = "لیست کتابها";
}
<div class="app-content-header">
	<div class="container-fluid">
		<div class="row">
			<div class="col-sm-6"><h3 class="mb-0">@ViewData["Title"]</h3></div>
			<div class="col-sm-6">
				<ol class="breadcrumb float-sm-end">
					<li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">خانه</a></li>
					<li class="breadcrumb-item"><a asp-controller="Category" asp-action="GetAllCategory">لیست دسته بندی</a></li>
					<li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
				</ol>
			</div>
		</div>
	</div>
</div>

}
<div class="app-content">
	<!--begin::Container-->
	<div class="container-fluid">
		<!--begin::Row-->
		<div class="row">
			<div class="col-12">
				<div class="card mb-4">
					@if (User.HasClaim("IsAdmin", "True"))
					{
						<div class="card-header">
							<a asp-action="CreateBookAsync" asp-route-categoryId="@Model.CategoryId" class="btn btn-primary">
								<i class="fas fa-plus ml-2"></i>افزودن کتاب جدید
							</a>
						</div>
					}
					<!-- /.card-header -->
					<div class="card-body">
						<table class="table table-striped table-bordered table-hover">
							<thead class="thead-dark">
								<tr>
									<th style="width: 50px">#</th>
									<th>تاریخ انتشار</th>
									<th>نام ناشر</th>
									<th>عنوان کتاب</th>
									<th>نویسنده</th>
									<th>امانت داده شده؟</th>
									<th>حذف شده؟</th>
									<th style="width: 200px">عملیات</th>
								</tr>
							</thead>
							<tbody>
								@if (Model != null && Model.Books.Any())
								{
									@foreach (var item in Model.Books)
									{
										<tr>
											<td>@(Model.Books.IndexOf(item) + 1)</td>

											<td>@item.PublicationDate.ToString("yyyy-mm-dd")</td>
											<td>@item.PublicationDate</td>

											<td>@item.Publisher</td>
											<td>@item.BookTitle</td>
											<td>@item.Author</td>

											<td>
												<i class="fas @(item.Borrow == true ? "fa-check text-success"
																			 			 : "fa-times text-danger")"></i>

									        </td>
								        	<td>
										        <i class="fas @(item.IsDeleted == true ? "fa-check text-success"
															 			 : "fa-times text-danger")"></i>
									        </td>

											
											<td>
												<i class="fas @(item.IsDeleted == true ? "fa-check text-success"
															 			 : "fa-times text-danger")"></i>
									        </td>


											<td>
												<div class="btn-group btn-group-sm">
											    @if (User.HasClaim("IsAdmin", "True"))
												{

														<a asp-action="EditBookAsync" asp-route-bookId="@item.BookId" class="btn btn-warning">
															<i class="fas fa-edit ml-2"></i>ویرایش
														</a>
														@if (item.IsDeleted)
														{
															<form asp-action="UnDeleteBookAsync" method="post" asp-route-bookId="@item.BookId"
																  onsubmit="return confirm('آیا از لغو حذف اطمینان دارید؟')" style="display:inline;">
																<input type="hidden" name="CategoryId" value="@item.CategoryId" />

																<button type="submit" class="btn btn-danger">
																	<i class="fas fa-trash ml-2"></i>بازیابی
																</button>
															</form>
														}
														else
														{
															<form asp-action="DeleteBookAsync" method="post" asp-route-bookId="@item.BookId"
																  onsubmit="return confirm('آیا از حذف اطمینان دارید؟')" style="display:inline;">
																<input type="hidden" name="CategoryId" value="@item.CategoryId" />

																<button type="submit" class="btn btn-danger">
																	<i class="fas fa-trash ml-2"></i>حذف
																</button>
															</form>
														}
												}
												     	@if (item.Borrow)
													    {
														    <form asp-action="ReturnBookAsync" method="post"
															  onsubmit="return confirm('آیا زمان پس دادن این کتاب رسیده ؟')" style="display:inline;">
															<input type="hidden" name="bookId" value="@item.BookId" />
															<input type="hidden" name="CategoryId" value="@item.CategoryId" />
															<button type="submit" class="btn btn-success">
																<i class="fas fa-hand-paper ml-2"></i>بازگشت
															</button>
														</form>
												     	}
												      	else
													    {
														    <form asp-action="BorrowingAsync" method="post"
															  onsubmit="return confirm('آیا از امانت دادن این کتاب اطمینان دارید؟')" style="display:inline;">
															<input type="hidden" name="bookId" value="@item.BookId" />
															<input type="hidden" name="CategoryId" value="@item.CategoryId" />
															<button type="submit" class="btn btn-success">
																<i class="fas fa-hand-paper ml-2"></i>امانت
															</button>
														</form>

                 										}

													

													

												</div>
											</td>
										</tr>
									}
								}
								else
								{
									<tr>
										<td colspan="8" class="text-center">هیچ کتابی یافت نشد</td>
									</tr>
								}
							</tbody>
						</table>
					</div>
					<!-- /.card-body -->
					<div class="card-footer clearfix">
						<ul class="pagination pagination-sm m-0 float-end">
							<li class="page-item"><a class="page-link" href="#">«</a></li>
							<li class="page-item"><a class="page-link" href="#">1</a></li>
							<li class="page-item"><a class="page-link" href="#">2</a></li>
							<li class="page-item"><a class="page-link" href="#">3</a></li>
							<li class="page-item"><a class="page-link" href="#">»</a></li>
						</ul>
					</div>
				</div>
			</div>
		</div>
		<!--end::Row-->
	</div>
	<!--end::Container-->
</div>