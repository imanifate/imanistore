@using BookStore.Domain.ViewModels.User
@model RegisterUserViewModl

@{
	ViewData["Title"] = "ثبت نام";
}

<!-- Content Header (Page header) -->
<section class="content-header">
	<div class="container-fluid">
		<div class="row mb-2">
			<div class="col-sm-6">
				<h1>@ViewData["Title"]</h1>
			</div>
			<div class="col-sm-6">
				<ol class="breadcrumb float-sm-left">
					<li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">خانه</a></li>
					<li class="breadcrumb-item active">@ViewData["Title"]</li>
				</ol>
			</div>
		</div>
	</div>
</section>

<section class="content">
	<div class="container-fluid">
		<div class="row">
			<div class="col-md-12">

				<div class="card card-primary">
					<div class="card-header">
						<h3 class="card-title">ثبت نام</h3>
					</div>

					<form asp-action="RgisterUserAsync" method="post">
						<div class="card-body">
							<div class="form-group">
								<label asp-for="NationalCode"></label>
								<input asp-for="NationalCode" type="text" class="form-control" placeholder="کد ملی خود را وارد کنید">
							</div>
						</div>

						<div class="card-body">
							<div class="form-group">
								<label asp-for="FullName" ></label>
								<input asp-for="FullName" type="text" class="form-control" placeholder="نام و نام خانوادگی خود را وارد کنید">
							</div>
						</div>
												<div class="card-body">
							<div class="form-group">
								<label asp-for="PhoneNumber"></label>
								<input asp-for="PhoneNumber" type="text" class="form-control" placeholder="شماره تلفن خود را وارد کنید">
							</div>
						</div>
						<div class="card-footer">
							<button type="submit" class="btn btn-primary">ثبت</button>
						</div>

					</form>
				</div>

			</div>


		</div>

	</div>
</section>