@if (User.Identity.IsAuthenticated)
{
    <div class="icon-header-item cl2 hov-cl1 trans-04 p-l-22 p-r-11 js-show-modal-search">
        <i class="zmdi zmdi-search"></i>
    </div>

    <div class="icon-header-item cl2 hov-cl1 trans-04 p-l-22 p-r-11 icon-header-noti js-show-cart" data-notify="2">
        <i class="zmdi zmdi-shopping-cart"></i>
    </div>

    <a href="#" class="dis-block icon-header-item cl2 hov-cl1 trans-04 p-l-22 p-r-11 icon-header-noti" data-notify="0">
        <i class="zmdi zmdi-favorite-outline"></i>
    </a>
    <a asp-controller="Home" asp-action="Index" class="dis-flex align-items-center icon-header-item cl2 hov-cl1 trans-04 p-l-40  p-r-10">
        <i class="zmdi zmdi-account"></i>
        <span class="stext-110 hov-cl1 trans-04 cl2 p-r-7">@User.Identity.Name خوش آمدید</span>
    </a>
    <a asp-action="Logout" asp-controller="Account" class="dis-flex align-items-center icon-header-item cl2 hov-cl1 trans-04 p-l-40  p-r-10">
        <i class="zmdi zmdi-close"></i>
        <span class="stext-110 hov-cl1 trans-04 cl2 p-r-7">خروج</span>
    </a>
}
else
{
    <a asp-action="LoginAsync" asp-controller="Account" class="dis-flex icon-header-item cl2 hov-cl1 trans-04 p-l-40">
        <i class="zmdi zmdi-account-circle"></i>
        <span class="mtext-110 hov-cl1 trans-04 cl2 p-r-7">ورود</span>
    </a>
    <a asp-action="RgisterUserAsync" asp-controller="User" class="dis-flex icon-header-item cl2 hov-cl1 trans-04 p-l-40  p-r-10">
        <i class="zmdi zmdi-account-add"></i>
        <span class="mtext-110 hov-cl1 trans-04 cl2 p-r-7">عضویت</span>
    </a>
}
