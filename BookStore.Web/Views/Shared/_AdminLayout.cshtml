<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
	<meta charset="utf-8">
	<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<meta name="title" content="AdminLTE 4 | Layout RTL">
	<meta name="author" content="ColorlibHQ">
	<meta name="description" content="AdminLTE is a Free Bootstrap 5 Admin Dashboard, 30 example pages using Vanilla JS.">
	<meta name="keywords" content="bootstrap 5, bootstrap, bootstrap 5 admin dashboard, bootstrap 5 dashboard, bootstrap 5 charts, bootstrap 5 calendar, bootstrap 5 datepicker, bootstrap 5 tables, bootstrap 5 datatable, vanilla js datatable, colorlibhq, colorlibhq dashboard, colorlibhq admin dashboard">
	<title>کتاب خانه</title>

	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.10.1/styles/overlayscrollbars.min.css" integrity="sha256-tZHrRjVqNSRyWg2wbppGnT833E/Ys0DHWGwT04GiqQg=" crossorigin="anonymous">
	<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" integrity="sha256-9kPW/n5nn53j4WMRYAxe9c1rCY96Oogo/MKSVdKzPmI=" crossorigin="anonymous">
	<link rel="stylesheet" href="/css/adminlte.rtl.css">
	<link rel="stylesheet" href="/css/fonts.css">
	<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary sidebar-open app-loaded">
	<div class="app-wrapper">
		<!--begin::Header-->
		<nav class="app-header navbar navbar-expand bg-body-tertiary" data-bs-theme="dark">
			<!--begin::Container-->
			<div class="container-fluid">
				<!--begin::Start Navbar Links-->
				<ul class="navbar-nav">
					<li class="nav-item">
						<a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
							<i class="bi bi-list"></i>
						</a>
					</li>
					<li class="nav-item d-none d-md-block">
						<div class="wrap-icon-header flex-w flex-r-m">
							<partial name="_LoggedInUser" />
						</div>
					</li>
				</ul>
				<!--end::Start Navbar Links-->
				<!--begin::End Navbar Links-->
				<ul class="navbar-nav ms-auto">
					<!--begin::Navbar Search-->
					<li class="nav-item">
						<a class="nav-link" data-widget="navbar-search" href="#" role="button">
							<i class="bi bi-search"></i>
						</a>
					</li>
					<!--end::Navbar Search-->
					<!--begin::Messages Dropdown Menu-->
					<li class="nav-item dropdown">
						<a class="nav-link" data-bs-toggle="dropdown" href="#">
							<i class="bi bi-chat-text"></i>
							<span class="navbar-badge badge text-bg-danger">5</span>
						</a>
						<div class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
							@for (int i = 0; i < 4; i++)
							{
								<a href="#" class="dropdown-item">
									<!--begin::Message-->
									<div class="d-flex">
										<div class="flex-shrink-0">
											<img src="/assets/img/user1-128x128.jpg" alt="User Avatar" class="img-size-50 rounded-circle me-3">
										</div>
										<div class="flex-grow-1">
											<h3 class="dropdown-item-title">
												فاطمه ایمانی
												<span class="float-end fs-7 text-danger"><i class="bi bi-star-fill"></i></span>
											</h3>
											<p class="fs-7">هر وقت تونستی بهم زنگ بزن...</p>
											<p class="fs-7 text-secondary">
												<i class="bi bi-clock-fill me-1"></i> 4 ساعت قبل
											</p>
										</div>
									</div>
									<!--end::Message-->
								</a>
								<div class="dropdown-divider"></div>
							}

							<a href="#" class="dropdown-item dropdown-footer">دیدن همه پیام ها</a>
						</div>
					</li>
					<!--end::Messages Dropdown Menu-->
					<!--begin::Notifications Dropdown Menu-->
					<li class="nav-item dropdown">
						<a class="nav-link" data-bs-toggle="dropdown" href="#">
							<i class="bi bi-bell-fill"></i>
							<span class="navbar-badge badge text-bg-warning">15</span>
						</a>
						<div class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
							<span class="dropdown-item dropdown-header">15 اعلان</span>
							<div class="dropdown-divider"></div>
							<a href="#" class="dropdown-item">
								<i class="bi bi-envelope me-2"></i> 4 new messages
								<span class="float-end text-secondary fs-7">3 دقیقه</span>
							</a>
							<div class="dropdown-divider"></div>
							<a href="#" class="dropdown-item">
								<i class="bi bi-people-fill me-2"></i> 8 درخواست دوستی
								<span class="float-end text-secondary fs-7">12 ساعت</span>
							</a>
							<div class="dropdown-divider"></div>
							<a href="#" class="dropdown-item">
								<i class="bi bi-file-earmark-fill me-2"></i> 3 گزارش جدید
								<span class="float-end text-secondary fs-7">2 روز</span>
							</a>
							<div class="dropdown-divider"></div>
							<a href="#" class="dropdown-item dropdown-footer"> دیدن همه اعلان ها </a>
						</div>
					</li>
					<!--end::Notifications Dropdown Menu-->
					<!--begin::Fullscreen Toggle-->
					<li class="nav-item">
						<a class="nav-link" href="#" data-lte-toggle="fullscreen">
							<i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
							<i data-lte-icon="minimize" class="bi bi-fullscreen-exit" style="display: none"></i>
						</a>
					</li>
					<!--end::Fullscreen Toggle-->
					<!--begin::User Menu Dropdown-->
					<li class="nav-item dropdown user-menu">
						<a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
							<img src="/assets/img/user2-160x160.jpg" class="user-image rounded-circle shadow" alt="User Image">
							<span class="d-none d-md-inline">فاطمه ایمانی</span>
						</a>
						<ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
							<!--begin::User Image-->
							<li class="user-header text-bg-primary">
								<img src="/assets/img/user2-160x160.jpg" class="rounded-circle shadow" alt="User Image">
								<p>
									فاطمه ایمانی - مدیر سایت
									<small>عضو از 21 نوامبر 2012</small>
								</p>
							</li>
							<!--end::User Image-->
							<!--begin::Menu Body-->
							<li class="user-body">
								<!--begin::Row-->
								<div class="row">
									<div class="col-4 text-center"><a href="#">دنبال کنندگان</a></div>
									<div class="col-4 text-center"><a href="#">فروش</a></div>
									<div class="col-4 text-center"><a href="#">دوستان</a></div>
								</div>
								<!--end::Row-->
							</li>
							<!--end::Menu Body-->
							<!--begin::Menu Footer-->
							<li class="user-footer">
								<a href="#" class="btn btn-default btn-flat">نمایه</a>
								<a href="#" class="btn btn-default btn-flat float-end">خروج از سیستم</a>
							</li>
							<!--end::Menu Footer-->
						</ul>
					</li>
					<!--end::User Menu Dropdown-->
				</ul>
				<!--end::End Navbar Links-->
			</div>
			<!--end::Container-->
		</nav>
		<!--end::Header-->
		<!--begin::Sidebar-->
		<aside class="app-sidebar bg-body-tertiary" data-bs-theme="dark">
			<!--begin::Sidebar Brand-->
			<div class="sidebar-brand">

				<a href="../index.html" class="brand-link">
					<img alt="@User.Identity.Name خوش امدی" class="brand-image opacity-100 shadow">
				</a>


			</div>
			<!--end::Sidebar Brand-->
			<!--begin::Sidebar Wrapper-->
			<div class="sidebar-wrapper" data-overlayscrollbars="host">
				<div class="os-size-observer">
					<div class="os-size-observer-listener"></div>
				</div>
				<div class="" data-overlayscrollbars-viewport="scrollbarHidden overflowXHidden overflowYScroll" tabindex="-1" style="margin-right: 0px; margin-bottom: -16px; margin-left: -16px; top: -8px; right: -8px; left: auto; width: calc(100% + 16px); padding: 8px;">
					<nav class="mt-2">
						<!--begin::Sidebar Menu-->
						<ul class="nav sidebar-menu flex-column" data-lte-toggle="treeview" role="menu" data-accordion="false">
							@if (User.HasClaim("IsAdmin", "True"))

							{

								<li class="nav-header">کاربران</li>
								<li class="nav-item">
									<a href="#" class="nav-link">
										<i class="nav-icon bi bi-people-fill"></i>
										<p>کاربران<i class="nav-arrow bi bi-chevron-right"></i></p>
									</a>
									<ul class="nav nav-treeview">
										<li class="nav-item">
											<a asp-controller="" asp-action="" class="nav-link">
												<i class="nav-icon bi bi-person-lines-fill"></i>
												<p>لیست کاربران</p>
											</a>
										</li>
										<li class="nav-item">
											<a asp-controller="User" asp-action="Creat" class="nav-link">
												<i class="nav-icon bi bi-person-fill-add"></i>
												<p>افزودن کاربر</p>
											</a>
										</li>
									</ul>
								</li>
							}
							<li class="nav-header">دسته بندی</li>
							<li class="nav-item">
								<a href="#" class="nav-link">
									<i class="nav-icon bi bi-box-seam-fill"></i>
									<p>دسته بندی<i class="nav-arrow bi bi-chevron-right"></i></p>
								</a>
								<ul class="nav nav-treeview">
									<li class="nav-item">
										<a asp-controller="Category" asp-action="GetAllCategory" class="nav-link">

											<i class="nav-icon bi bi-bookmarks-fill"></i>
											<p>لیست دسته بندی</p>
										</a>
									</li>
									@if (User.HasClaim("IsAdmin", "True"))
									{
										<li class="nav-item">
											<a asp-controller="Category" asp-action="CreateCategory" class="nav-link">
												<i class="nav-icon bi bi-circle"></i>
												<p>افزودن دسته اصلی</p>
											</a>
										</li>
									}
								</ul>
							</li>

							<li class="nav-item">
								<a href="#" class="nav-link">
									<i class="nav-icon bi bi-box-seam-fill"></i>
									<p> کتابها<i class="nav-arrow bi bi-chevron-right"></i></p>
								</a>
								<ul class="nav nav-treeview">
									<li class="nav-item">
										<a asp-controller="Book" asp-action="SearchBookAndAuthorasync" class="nav-link">
											<i class="nav-icon bi bi-bookmarks-fill"></i>
											<p>کتاب مورد نظرت رو پیدا کن</p>
										</a>
									</li>
									
								</ul>
								<ul class="nav nav-treeview">
									<li class="nav-item">
										<a asp-controller="Book" asp-action="SearchAuthorasync" class="nav-link">
											<i class="nav-icon bi bi-bookmarks-fill"></i>
											<p>کتابهای نویسنده مورد نظرت رو پیدا کن</p>
										</a>
									</li>

								</ul>
							</li>
							<li class="nav-header">ارتباطات</li>
							<li class="nav-item">
								<a href="#" class="nav-link">
									<i class="nav-icon bi bi-globe"></i>
									<p>ارتباطات<i class="nav-arrow bi bi-chevron-right"></i></p>
								</a>
								<ul class="nav nav-treeview">
									<li class="nav-item">
										<a asp-controller="AnswerToQuestion" asp-action="QuestionList" class="nav-link">

											<i class="nav-icon bi bi-circle"></i>
											<p>لیست تماس با ما</p>
										</a>
									</li>
									<li class="nav-item">
										<a asp-controller="FAQ" asp-action="CreatFAQ" class="nav-link">
											<i class="nav-icon bi bi-circle"></i>
											<p> پاسخ به سوالات پرتکرار</p>
										</a>
									</li>
									<li class="nav-item">
										<a asp-controller="FAQ" asp-action="FAQGetAll" class="nav-link">
											<i class="nav-icon bi bi-circle"></i>
											<p>لیست پرسش های متداول</p>
										</a>
									</li>
								</ul>
							</li>
							<li class="nav-header">تنظیمات سایت</li>
							<li class="nav-item">
								<a href="#" class="nav-link">
									<i class="nav-icon bi bi-gear-fill"></i>
									<p> تظیمات<i class="nav-arrow bi bi-chevron-right"></i></p>
								</a>
								<ul class="nav nav-treeview">
									<li class="nav-item">
										<a asp-area="" asp-controller="" asp-action="" class="nav-link">
											<i class="nav-icon bi bi-circle"></i>
											<p>تنظیمات اولیه</p>
										</a>
									</li>
								</ul>
							</li>
						</ul>
						<!--end::Sidebar Menu-->
					</nav>
				</div>
				<div class="os-scrollbar os-scrollbar-horizontal os-theme-light os-scrollbar-auto-hide os-scrollbar-handle-interactive os-scrollbar-track-interactive os-scrollbar-cornerless os-scrollbar-unusable os-scrollbar-rtl os-scrollbar-auto-hide-hidden" style="--os-viewport-percent: 1; --os-scroll-direction: 0;">
					<div class="os-scrollbar-track">
						<div class="os-scrollbar-handle"></div>
					</div>
				</div>
				<div class="os-scrollbar os-scrollbar-vertical os-theme-light os-scrollbar-auto-hide os-scrollbar-handle-interactive os-scrollbar-track-interactive os-scrollbar-visible os-scrollbar-cornerless os-scrollbar-rtl os-scrollbar-auto-hide-hidden" style="--os-viewport-percent: 0.5871; --os-scroll-direction: 0;">
					<div class="os-scrollbar-track">
						<div class="os-scrollbar-handle"></div>
					</div>
				</div>
			</div>
			<!--end::Sidebar Wrapper-->
		</aside>
		<!--end::Sidebar-->
		<!--begin::App Main-->
		<main class="app-main">
			@RenderBody()
		</main>
		<!--end::App Main-->
		<!--begin::Footer-->
		<footer class="app-footer">
			<div class="float-end d-none d-sm-inline">هرچی دلت بخواد</div>
			<strong>
				Copyright © 2014-2024&nbsp;
				<a href="https://adminlte.io" class="text-decoration-none">فاطمه ایمانی</a>.
			</strong>
			تمامی حقوق محفوظ است.
		</footer>
		<sweet-alert />
		<!--end::Footer-->
		<div class="sidebar-overlay"></div>
	</div>
	<!--begin::Script-->
	<script src="https://cdn.jsdelivr.net/npm/overlayscrollbars@2.10.1/browser/overlayscrollbars.browser.es6.min.js" integrity="sha256-dghWARbRe2eLlIJ56wNB+b760ywulqK3DzZYEpsg2fQ=" crossorigin="anonymous"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
	<script src="/js/adminlte.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

	<script>
		const SELECTOR_SIDEBAR_WRAPPER = '.sidebar-wrapper';
		const Default = {
		  scrollbarTheme: 'os-theme-light',
		  scrollbarAutoHide: 'leave',
		  scrollbarClickScroll: true,
		};
		document.addEventListener('DOMContentLoaded', function () {
		  const sidebarWrapper = document.querySelector(SELECTOR_SIDEBAR_WRAPPER);
		  if (sidebarWrapper && typeof OverlayScrollbarsGlobal?.OverlayScrollbars !== 'undefined') {
			OverlayScrollbarsGlobal.OverlayScrollbars(sidebarWrapper, {
			  scrollbars: {
				theme: Default.scrollbarTheme,
				autoHide: Default.scrollbarAutoHide,
				clickScroll: Default.scrollbarClickScroll,
			  },
			});
		  }
		});
	</script>
	@RenderSection("Scripts", false)
	 <partial name="_SweatAlertPartial" /> 

</body>
</html>