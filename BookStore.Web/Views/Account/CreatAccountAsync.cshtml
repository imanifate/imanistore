@using BookStore.Domain.ViewModels.Account
@model AccountViewModl

<section class="bg-white" style="height:80px;"></section>
<section class="bg-img1 txt-center p-lr-15 p-tb-92" style="background-image: url('images/bg-01.jpg');">
	<h2 class="ltext-105 cl0 txt-center">
		ثبت نام
	</h2>
</section>
<section class="bg0 p-t-104 p-b-116">
	<div class="container">
		<div class="flex-w flex-c-m">
			<form asp-controller="Account" asp-action="CreatAccountAsync" method="post" class="size-210 bor10 p-lr-70 p-t-55 p-b-70 p-lr-15-lg w-full-md">
				<h4 class="mtext-105 cl2 txt-center p-b-30">ثبت نام</h4>

				<div class="bor8 m-b-20 how-pos4-parent">
					<input asp-for="UserName" class="stext-111 cl2 plh3 size-116 p-l-62 p-r-30" type="text" placeholder="نام کاربری">
					<img class="how-pos4 pointer-none" src="images/icons/icon-email.png">
					<span asp-validation-for="UserName" class="inner-text text-danger"></span>
				</div>
				<div class="bor8 m-b-20 how-pos4-parent">
					<input asp-for="Email" class="stext-111 cl2 plh3 size-116 p-l-62 p-r-30" type="email" placeholder="ایمیل">
					<img class="how-pos4 pointer-none" src="images/icons/icon-email.png">
					<span asp-validation-for="Email" class="inner-text text-danger"></span>
				</div>
				<div class="bor8 m-b-20 how-pos4-parent">
					<input asp-for="PasswordHash" class="stext-111 cl2 plh3 size-116 p-l-62 p-r-30" type="password" placeholder="کلمه عبور">
					<img class="how-pos4 pointer-none" src="images/icons/icon-lock.png">
					<span asp-validation-for="PasswordHash" class="inner-text text-danger"></span>
				</div>
				<div class="bor8 m-b-20 how-pos4-parent">
					<input asp-for="RePassword" class="stext-111 cl2 plh3 size-116 p-l-62 p-r-30" type="password" placeholder="تکرار کلمه عبور">
					<img class="how-pos4 pointer-none" src="images/icons/icon-lock.png">
					<span asp-validation-for="RePassword" class="inner-text text-danger"></span>
				</div>
				<div class="m-b-20">
					<label class="stext-111 cl2 plh3 p-l-62 p-r-30">
						<input asp-for="Rules" type="checkbox" name="RememberMe" class="checkbox-inline">
						قوانین؟
					</label>
					<span asp-validation-for="Rules" class="inner-text text-danger"></span>
				</div>
				<button type="submit" class="flex-c-m stext-101 cl0 size-121 bg3 bor1 hov-btn3 p-lr-15 trans-04 pointer" aria-label="ورود به سیستم">
					ثبت نام
				</button>
			</form>
		</div>
	</div>
</section>